# Off-chain business database. Keep `file` for zero-config local demo;
# switch to `supabase` after applying supabase/migrations and setting the server-only credentials below.
CHECK_DI_DB_DRIVER=file
# CHECK_DI_DATA_FILE=.data/check-di-store.json
# CHECK_DI_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# CHECK_DI_SUPABASE_SERVICE_ROLE_KEY=
# Supabase Auth user access tokens are validated server-side against /auth/v1/user.
# `optional` keeps legacy demo access while enabling authenticated organization/Phantom flows.
# Switch to `required` for the final organization-only management demo.
CHECK_DI_AUTH_MODE=optional
# Optional stable demo owner provisioning. Keep real credentials only in ignored .env.local or shell env.
# CHECK_DI_DEMO_OWNER_EMAIL=
# CHECK_DI_DEMO_OWNER_PASSWORD=
# CHECK_DI_DEMO_ORGANIZATION_ID=org-check-di-demo
# CHECK_DI_DEMO_ORGANIZATION_NAME=Check-Di Demo Organization
# CHECK_DI_DEMO_ORGANIZATION_SLUG=check-di-demo
# Do not expose the service-role key to the browser.

NEXT_PUBLIC_SOLANA_NETWORK=devnet
NEXT_PUBLIC_SOLANA_RPC_URL=https://api.devnet.solana.com
NEXT_PUBLIC_CHECK_DI_REGISTRY_PROGRAM_ID=9sNDitEeYSFQ7LxmNuaiZPoCLVdrzhdR8P5zmoEW78Yi
CHECK_DI_SOLANA_AUTO_ANCHOR=true
CHECK_DI_SOLANA_AUTO_AIRDROP=true
# Optional: 32-byte Ed25519 seed, hex or base64. Keep real values out of Git.
# CHECK_DI_SOLANA_FEE_PAYER_SEED=

# Raw documents stay private/off-chain. Defaults to `supabase` when CHECK_DI_DB_DRIVER=supabase,
# otherwise `file`. The Supabase bucket is private and created by the migration.
# CHECK_DI_DOCUMENT_STORAGE_DRIVER=file
# CHECK_DI_SUPABASE_DOCUMENT_BUCKET=check-di-documents
# Optional local document storage root. Defaults to .data/documents.
# CHECK_DI_DOCUMENT_ROOT=
